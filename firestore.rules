rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public catalog: any signed-in user can read exercises & routine
    // templates. Writes are blocked from the client (seeded via admin/script).
    match /exercises/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /routines/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Per-user private data. Covers the profile doc (incl. activeRoutineIds)
    // and all subcollections: logs, exercises (custom), routines (custom),
    // flexibility. Only the owner can read/write.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
